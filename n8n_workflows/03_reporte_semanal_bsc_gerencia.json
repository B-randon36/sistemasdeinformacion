{
  "name": "Generate Weekly Executive BSC Report with CSV",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "c3d4e5f6-0003-4000-8000-000000000001",
      "name": "Schedule Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {},
      "id": "c3d4e5f6-0003-4000-8000-000000000002",
      "name": "Run Manual Report",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        420
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://52.86.231.75:8000/api/v1/reportes/consolidado?periodo=2026-10",
        "options": {
          "timeout": 10000
        }
      },
      "id": "c3d4e5f6-0003-4000-8000-000000000003",
      "name": "Fetch Consolidated BSC Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        320
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://52.86.231.75:8000/api/v1/reportes/export-csv?periodo=2026-10",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          },
          "timeout": 10000
        }
      },
      "id": "c3d4e5f6-0003-4000-8000-000000000004",
      "name": "Download BSC CSV File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        320
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "rep-asunto",
              "name": "asunto_correo",
              "value": "={{ 'Reporte Semanal Balanced Scorecard - AGRO PERUVIAN FOODS (' + $('Fetch Consolidated BSC Report').item.json.resumen_ejecutivo.cumplimiento_global + '%)' }}",
              "type": "string"
            },
            {
              "id": "rep-cuerpo",
              "name": "cuerpo_ejecutivo",
              "value": "={{ (() => {\n  const r = $('Fetch Consolidated BSC Report').item.json;\n  const res = r.resumen_ejecutivo;\n  const p = res.perspectivas;\n  return `REPORTE EJECUTIVO SEMANAL - AGRO PERUVIAN FOODS S.A.C.\\nPeríodo: ${r.periodo}\\nCumplimiento Global Ponderado: ${res.cumplimiento_global}%\\n\\nPerspectivas BSC:\\n- Financiera: ${p.FINANCIERA.avance}%\\n- Cliente: ${p.CLIENTE.avance}%\\n- Procesos Internos: ${p.PROCESOS_INTERNOS.avance}%\\n- Aprendizaje y Crecimiento: ${p.APRENDIZAJE.avance}%\\n\\nSemáforos (${res.semaforos.total} KPIs): Cumplidos ${res.semaforos.cumplidos} | En Alerta ${res.semaforos.alerta} | Críticos ${res.semaforos.criticos} | Sin Datos ${res.semaforos.sin_datos}\\n\\nSe adjunta el archivo CSV oficial del Cuadro de Mando Integral.`;\n})() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c3d4e5f6-0003-4000-8000-000000000005",
      "name": "Build Executive Email Content",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1020,
        320
      ],
      "notes": "Adjunta la propiedad binaria 'data' (archivo CSV) en tu nodo de Gmail/Email."
    }
  ],
  "connections": {
    "Schedule Monday 08:00": {
      "main": [
        [
          {
            "node": "Fetch Consolidated BSC Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Manual Report": {
      "main": [
        [
          {
            "node": "Fetch Consolidated BSC Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Consolidated BSC Report": {
      "main": [
        [
          {
            "node": "Download BSC CSV File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download BSC CSV File": {
      "main": [
        [
          {
            "node": "Build Executive Email Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Lima"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
